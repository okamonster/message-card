{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "extends": ["../../packages/eslint-config/biome.json"],
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignore": [
      "dist/**",
      "node_modules/**",
      ".output/**",
      "src/routeTree.gen.ts",
      "worker-configuration.d.ts",
      ".wrangler/**"
    ]
  },
  "formatter": {
    "enabled": true
  },
  "linter": {
    "enabled": true
  }
}
